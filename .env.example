# Copied to `.env`, this file configures `docker compose up`.

# true = generated demo data, no Google account needed
GA_MOCK_MODE=true
# Freeze the mock clock (YYYY-MM-DD) for reproducible demos — optional
# MOCK_TODAY=2025-03-15

# Required when GA_MOCK_MODE=false (python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Where the browser reaches each service
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8000

# Report cache (Redis container)
REPORT_CACHE_TTL=300
REDIS_MAXMEMORY=128mb

# Host ports
FRONTEND_PORT=5173
BACKEND_PORT=8000
REDIS_PORT=6379
