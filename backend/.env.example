# OAuth 2.0 credentials from Google Cloud Console
# https://console.cloud.google.com/ → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Must match one of the Authorized redirect URIs in your Google Cloud Console OAuth client
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# A long random string used to sign session cookies (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=change-me-to-a-random-secret

# Allowed origin for CORS (your React dev server)
FRONTEND_ORIGIN=http://localhost:5173
