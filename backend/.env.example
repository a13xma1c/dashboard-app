# ── Mock mode ─────────────────────────────────────────────────────────────────
# Set to true to run without Google credentials. The API serves deterministic,
# realistic-looking analytics data and "Sign in with Google" logs you straight in.
GA_MOCK_MODE=false

# ── Google OAuth 2.0 (required unless GA_MOCK_MODE=true) ──────────────────────
# https://console.cloud.google.com/ → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Must match one of the Authorized redirect URIs in your Google Cloud Console OAuth client
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# A long random string used to sign session cookies
# (generate with: python -c "import secrets; print(secrets.token_hex(32))")
# Required unless GA_MOCK_MODE=true.
SESSION_SECRET=change-me-to-a-random-secret

# Allowed origin for CORS (your React dev server)
FRONTEND_ORIGIN=http://localhost:5173
# Optional: extra comma-separated CORS origins
# CORS_ORIGINS=http://127.0.0.1:5173

# ── Optional tuning ───────────────────────────────────────────────────────────
# Mark the session cookie Secure (set to true when serving over HTTPS)
SESSION_HTTPS_ONLY=false
# Cache identical Google Analytics report requests per user for N seconds (0 disables)
REPORT_CACHE_TTL=300
# Freeze "today" for mock data (YYYY-MM-DD) — handy for reproducible demos/screenshots
# MOCK_TODAY=2025-03-15
